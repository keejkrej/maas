# Copy to .env. Firebase deploy reads .env for non-secret config; `npm run dev` reads it via your shell.
# Secrets (OLLAMA_API_KEY, MAAS_ADMIN_TOKEN) go in Secret Manager on Firebase:
#   firebase functions:secrets:set OLLAMA_API_KEY
#   firebase functions:secrets:set MAAS_ADMIN_TOKEN
# For local dev, set them in your shell instead.

# Ollama Cloud models (see https://ollama.com/search?c=cloud)
MAAS_AGENT_MODEL=glm-5.3-flash
MAAS_DREAM_MODEL=glm-5.3-flash
# MAAS_LLM_URL=https://ollama.com

# Queue a dream after N observations per team (0 = only nightly / on request)
MAAS_DREAM_EVERY=25

# Deploy-time options
MAAS_REGION=us-central1   # must suit your Firestore location (nam5 -> us-central1, eur3 -> europe-west1)
MAAS_TIMEZONE=Europe/Berlin
