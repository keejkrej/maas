{
  "name": "maas",
  "version": "0.1.0",
  "description": "Memory as a Service: an MCP endpoint backed by a memory agent that curates a team's markdown memory (Firebase + Ollama Cloud).",
  "type": "module",
  "main": "dist/functions.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "firebase deploy",
    "logs": "firebase functions:log",
    "smoke": "tsx scripts/smoke.ts",
    "acl-test": "tsx scripts/acl-test.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
